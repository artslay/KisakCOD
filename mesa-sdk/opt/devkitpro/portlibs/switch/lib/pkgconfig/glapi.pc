prefix=/opt/devkitpro/portlibs/switch
includedir=${prefix}/include
libdir=${prefix}/lib

Name: glapi
Description: Mesa shared OpenGL dispatch library
Version: 26.2.1
Requires: zlib >=  1.2.3
Libs: -L${libdir} -lglapi -pthread -lm -lmesa_util_c11 -lblake3 -lmesa_util -lmesa_util_simd
Libs.private: -lpthread
Cflags: -I${includedir} -pthread -DXXH_FORCE_ALIGN_CHECK=0 -DXXH_FORCE_MEMORY_ACCESS=0
